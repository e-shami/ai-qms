# AI-QMS environment configuration
# Copy to `.env` and adjust values for your machine. docker-compose reads this file.
# Do not commit `.env` — it may contain secrets.

# --- Postgres (db service) ---
POSTGRES_USER=aiqms
POSTGRES_PASSWORD=aiqms
POSTGRES_DB=aiqms

# --- Backend ---
# Service name `db` resolves inside the compose network.
DATABASE_URL=postgresql+psycopg://aiqms:aiqms@db:5432/aiqms
# JSON array for pydantic-settings (CORS_ORIGINS: list[str])
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
# JWT signing key — set a long random value in any real deployment.
SECRET_KEY=dev-secret-change-me-in-production
# Rate limits (attempts / window seconds)
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300
INSTITUTION_VERIFY_RATE_LIMIT=30
INSTITUTION_VERIFY_RATE_WINDOW_SECONDS=60

# --- Frontend ---
# Must include the /api/v1 prefix (this is the client-side base path).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# --- WhatsApp Bot ---
# Get these from Meta Developer Console > WhatsApp > Configuration
WHATSAPP_TOKEN=WHATSAPP_TOKEN=EAAVNRZC9fAs4BSUJg0SX1WiD6rWwCadBAcSoZBLL1FFkwoVM5A7ToNKQG2ZBavJ8xxZA00Jb9t4pPmqN32Ug1xKvCxX8kWj4kRJisttLieRyvz9sUPSuG7ZAFJHzgDamEMuYVXq9eD6MF1BdWxX22WmpMffuIoGRoJZAHe9kmYNy519oYtiNtLUlTKXyr6mBEBrgZDZD
PHONE_NUMBER_ID=1308714752329052
WEBHOOK_VERIFY_TOKEN=my-secret-verify-token-min-32-chars
WHATSAPP_API_VERSION=v20.0

# Upstash Redis (free tier at upstash.com)

UPSTASH_REDIS_REST_URL="https://precious-filly-169470.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAApX-AAIgcDI5YjEyZDAwYjBhMDk0MTQwYmNhODg0MTMyNzBlNzQ2Nw"

# Internal API key for backend communication (generate a random string)
INTERNAL_API_KEY=your-internal-api-key-change-in-production

# Backend API URL (use service name inside compose)
BACKEND_API_URL=http://backend:8000/api/v1

# Session TTL in hours
SESSION_TTL_HOURS=24

# Logging
LOG_LEVEL=info

# --- CV Service (Phase 7B) ---
# Camera source: USB index (0), RTSP URL, or video file path
CAMERA_SOURCE=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15

# YOLO settings
YOLO_MODEL=yolov8n.pt
YOLO_CONF_THRESHOLD=0.4
YOLO_IOU_THRESHOLD=0.5
YOLO_DEVICE=cpu

# ROI config file (in cv-service/)
ROI_CONFIG_PATH=roi_config.json

# Backend integration
BACKEND_URL=http://backend:8000/api/v1
INTERNAL_API_KEY=your-internal-api-key-change-in-production
PUSH_INTERVAL_SECONDS=2

# Which counter this camera monitors (matches Counter.id in DB)
CAMERA_COUNTER_ID=

# Processing
FRAME_SKIP=1
MIN_DETECTION_AREA=100