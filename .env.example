# Shared environment example. Replace placeholders locally before deployment.
# Never commit populated credentials. Placeholder credentials are not production-safe.
# Optional integrations remain disabled where documented below.

# PostgreSQL: use matching values in DATABASE_URL; URL-encode credentials there.
POSTGRES_USER=replace_with_database_user
POSTGRES_PASSWORD=replace_with_database_password
POSTGRES_DB=replace_with_database_name

# Backend: SQLAlchemy PostgreSQL URL using the psycopg driver.
DATABASE_URL=postgresql+psycopg://replace_with_database_user:replace_with_database_password@db:5432/replace_with_database_name
# JSON array of allowed frontend origins, not a comma-separated string.
CORS_ORIGINS=["http://localhost:3000"]
# Replace with a cryptographically random signing secret before running the backend.
SECRET_KEY=replace_with_random_signing_secret
# Login and institution verification limits: requests per window in seconds.
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300
INSTITUTION_VERIFY_RATE_LIMIT=30
INSTITUTION_VERIFY_RATE_WINDOW_SECONDS=60
# Public intake issuance and lookup limits: requests per window in seconds.
PUBLIC_ISSUE_RATE_LIMIT=10
PUBLIC_ISSUE_RATE_WINDOW_SECONDS=60
PUBLIC_LOOKUP_RATE_LIMIT=60
PUBLIC_LOOKUP_RATE_WINDOW_SECONDS=60

# Frontend: browser-accessible backend URLs; use HTTPS/WSS in production.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
# Public WhatsApp contact: international digits only, without +; empty hides contact.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# WhatsApp bot: required credentials must be replaced before starting the bot.
WHATSAPP_TOKEN=replace_with_meta_access_token
# Meta phone-number resource ID, not the public WhatsApp telephone number.
PHONE_NUMBER_ID=replace_with_meta_phone_number_id
# Choose a random verification token and configure the same token in Meta.
WEBHOOK_VERIFY_TOKEN=replace_with_random_webhook_verify_token
WHATSAPP_API_VERSION=v23.0
WHATSAPP_APP_SECRET=replace_with_meta_app_secret
# Public bot number for token-copy links: international digits only, without +.
# Leave empty to disable the WhatsApp link fallback.
WHATSAPP_BOT_NUMBER=

# Empty template name disables outbound token-copy template sending.
# Enable only with an approved Meta template name and its matching language code.
WHATSAPP_COPY_TEMPLATE=
WHATSAPP_COPY_LANGUAGE=

# Upstash Redis REST endpoint and token; replace both before starting the bot.
# The reserved .invalid hostname is a placeholder, not a working endpoint.
UPSTASH_REDIS_REST_URL=https://replace-with-upstash-endpoint.invalid
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_rest_token

# Shared authentication key: use the same random value in backend, bot, and CV.
INTERNAL_API_KEY=replace_with_random_internal_api_key

# Bot-to-backend URL reachable from the bot container.
BACKEND_API_URL=http://backend:8000/api/v1
# Public frontend origin for intake links; empty disables public web links.
# When enabled, use the externally reachable HTTPS origin, without a trailing slash.
PUBLIC_WEB_URL=

# Bot session lifetime in hours.
SESSION_TTL_HOURS=24

# Bot logging: debug, info, warn, or error; also consumed by the CV service.
LOG_LEVEL=info

# CV camera: USB index, video file path, or RTSP URL (never commit embedded credentials).
# Width/height are pixels; FPS is the requested capture frame rate.
CAMERA_SOURCE=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15

# YOLO model path, confidence/IoU thresholds (0 to 1), and device (cpu or cuda:0).
YOLO_MODEL=yolov8n.pt
YOLO_CONF_THRESHOLD=0.4
YOLO_IOU_THRESHOLD=0.5
YOLO_DEVICE=cpu

# CV region-of-interest configuration path.
ROI_CONFIG_PATH=roi_config.json

# CV-to-backend URL and shared key; keep this duplicate key identical to the one above.
BACKEND_URL=http://backend:8000/api/v1
INTERNAL_API_KEY=replace_with_random_internal_api_key
# Seconds between CV updates.
PUSH_INTERVAL_SECONDS=2

# Optional counter UUID for this camera; leave empty when no counter is assigned.
CAMERA_COUNTER_ID=

# Process every N frames; minimum detection bounding-box area is in square pixels.
FRAME_SKIP=1
MIN_DETECTION_AREA=100
